# Snowflake connection (same shape as api2/.env)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your.name@retailinsight.io
SNOWFLAKE_ROLE=your_snowflake_role
SNOWFLAKE_WAREHOUSE=STORE_INSIGHT_WH
SNOWFLAKE_DATABASE=STORE_INSIGHT_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Optional: PEM key auth (alternative to externalbrowser)
# SNOWFLAKE_PRIVATE_KEY_PATH=C:/path/to/key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=...

# CORS — Vite frontend dev port
ALLOWED_ORIGINS=http://localhost:8081
