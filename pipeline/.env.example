# NEVER commit a real .env — see .windsurf/rules/no-credentials-in-git.md
# Account identifier uses the ORG-ACCOUNT format (e.g. MYORG-MYACCOUNT),
# NOT the bare account name or account.region.cloud.
SNOWFLAKE_ACCOUNT=your-org-your-account
# Service account with PAT: set SNOWFLAKE_PASSWORD to the PAT token
SNOWFLAKE_USER=your_service_account
SNOWFLAKE_PASSWORD=your-pat-token-or-password
SNOWFLAKE_ROLE=your_snowflake_role
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema

# Table overrides — optional, defaults shown
# Override these to point at dev/test schemas without touching code
# ALERTS_OUTPUT_TABLE=STORE_INSIGHT_DB.PUBLIC.ALERTS_PIPELINE
# ALERTS_OSA_TABLE=ANALYSIS.FINAL.LSM_ITEM_STORE_DAY_REPORTING_PERIOD
# ALERTS_HIERARCHY_TABLE=ANALYSIS.FINAL.LSM_ITEM_HIERARCHY
# ALERTS_FEEDBACK_TABLE=ANALYSIS.FINAL.LSM_ALERT_FEEDBACK
