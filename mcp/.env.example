# Copy this file to `.env` for committed/shared defaults (e.g. Railway values).
# For local-only overrides, create `.env.local` — it is loaded AFTER `.env`
# and wins on any key it sets. Typical workflow:
#   .env         — deploy/shared Snowflake creds and API key
#   .env.local   — your local dev Snowflake creds (not committed)

# ── MCP server auth (OAuth via WorkOS AuthKit) ──────────────────────────────
# Claude.ai and other MCP clients authenticate users through WorkOS. The
# server below just validates the JWT access tokens WorkOS issues; it never
# needs the WorkOS secret API key.
#
# AuthKit domain from the WorkOS dashboard (no trailing slash).
WORKOS_AUTHKIT_DOMAIN=https://your-slug.authkit.app
# Client ID of the WorkOS application (optional — only used to validate the
# `aud` claim when set).
WORKOS_CLIENT_ID=
# Public URL of this MCP resource, used in /.well-known/oauth-protected-resource.
# Should be the externally-reachable URL including the /mcp path (no trailing
# slash).
MCP_RESOURCE_URL=https://your-railway-domain/mcp

# ── Snowflake connection ─────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=SVC_STORE_INSIGHT
SNOWFLAKE_ROLE=ACL_SNOWFLAKE_RI_EOE_PRD_DP_USER
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_LEARNING_DB
SNOWFLAKE_SCHEMA=STORE_INSIGHT

# Private-key auth (preferred). Base64-encoded PEM is safest for Railway:
#   base64 -w0 rsa_key.p8 > key.b64
SNOWFLAKE_PRIVATE_KEY_B64=
# SNOWFLAKE_PRIVATE_KEY=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Fallback password auth (not recommended for production):
# SNOWFLAKE_PASSWORD=

# ── Optional overrides ───────────────────────────────────────────────────────
# Override the alerts table if the pipeline writes somewhere non-default.
# ALERTS_OUTPUT_TABLE=SNOWFLAKE_LEARNING_DB.STORE_INSIGHT.ALERTS_PIPELINE
